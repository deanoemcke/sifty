+import Database from 'better-sqlite3';
+import { describe, expect, it } from 'vitest';
+import { initSchema } from './db';
+import {
+  getFacebookCookieStatus,
+  loadFacebookCookies,
+  MissingFacebookCookiesError,
+  saveFacebookCookies,
+  getStoredFacebookCookiesJson,
+} from './facebookCookies';
+import { getSchedulerSettings } from './settings';
+
+function freshDb(): Database.Database {
+  const database = new Database(':memory:');
+  initSchema(database);
+  return database;
+}
+const GOOD = JSON.stringify([
+  { name: 'c_user', value: '1' },
+  { name: 'xs', value: '2' },
+]);
+
+describe('R1-F001 malformed cookie elements', () => {
+  it.each(['[null]', '[1]', '["a"]', '[{}]', '[{"name":1}]'])(
+    'rejects %s with MissingFacebookCookiesError and keeps the earlier set',
+    (bad) => {
+      const database = freshDb();
+      saveFacebookCookies(database, GOOD);
+      expect(() => saveFacebookCookies(database, bad)).toThrow(MissingFacebookCookiesError);
+      expect(getStoredFacebookCookiesJson(database)).toBe(GOOD);
+    }
+  );
+});
