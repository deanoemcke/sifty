+import Database from 'better-sqlite3';
+import { describe, expect, it } from 'vitest';
+import { initSchema } from './db';
+import {
+  getFacebookCookieStatus,
+  loadFacebookCookies,
+  MissingFacebookCookiesError,
+  saveFacebookCookies,
+  getStoredFacebookCookiesJson,
+} from './facebookCookies';
+import { getSchedulerSettings } from './settings';
+
+function freshDb(): Database.Database {
+  const database = new Database(':memory:');
+  initSchema(database);
+  return database;
+}
+const GOOD = JSON.stringify([
+  { name: 'c_user', value: '1' },
+  { name: 'xs', value: '2' },
+]);
+
+describe('R1-F003 status', () => {
+  it('does not report a past login expiry as synced while load would also succeed on xs only', () => {
+    const database = freshDb();
+    const nowSeconds = Date.now() / 1000;
+    saveFacebookCookies(
+      database,
+      JSON.stringify([
+        { name: 'c_user', value: '1', expirationDate: nowSeconds + 0.3 },
+        { name: 'xs', value: '2' },
+      ])
+    );
+    const realNow = Date.now;
+    Date.now = () => realNow() + 2000;
+    try {
+      const status = getFacebookCookieStatus(database);
+      expect(loadFacebookCookies(database).length).toBe(1);
+      // expected: status cannot claim a login expiry that already passed
+      expect(status.isSynced && status.loginExpiryMs !== null && status.loginExpiryMs < Date.now()).toBe(false);
+    } finally {
+      Date.now = realNow;
+    }
+  });
+  it('distinguishes no login cookies from session-cookie login', () => {
+    const a = freshDb();
+    saveFacebookCookies(a, JSON.stringify([{ name: 'wd', value: '3' }]));
+    const b = freshDb();
+    saveFacebookCookies(b, GOOD);
+    expect(getFacebookCookieStatus(a)).not.toEqual(getFacebookCookieStatus(b));
+  });
+  it('does not throw a raw SyntaxError on corrupt stored JSON', () => {
+    const database = freshDb();
+    database.prepare('INSERT INTO facebook_cookies (id, cookies_json, synced_at) VALUES (1, ?, ?)').run('oops', 1);
+    expect(() => getFacebookCookieStatus(database)).not.toThrow();
+  });
+});
+
