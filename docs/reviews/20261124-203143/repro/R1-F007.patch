+import Database from 'better-sqlite3';
+import { describe, expect, it } from 'vitest';
+import { initSchema } from './db';
+import {
+  getFacebookCookieStatus,
+  loadFacebookCookies,
+  MissingFacebookCookiesError,
+  saveFacebookCookies,
+  getStoredFacebookCookiesJson,
+} from './facebookCookies';
+import { getSchedulerSettings } from './settings';
+
+function freshDb(): Database.Database {
+  const database = new Database(':memory:');
+  initSchema(database);
+  return database;
+}
+const GOOD = JSON.stringify([
+  { name: 'c_user', value: '1' },
+  { name: 'xs', value: '2' },
+]);
+
+describe('R1-F007 stored settings', () => {
+  it('does not throw SyntaxError on a non-JSON stored value', () => {
+    const database = freshDb();
+    database.prepare("INSERT INTO settings (key, value, updated_at) VALUES ('maxSearchesPerTick','abc',1)").run();
+    expect(() => getSchedulerSettings(database)).not.toThrow();
+  });
+  it('does not accept 0 for maxSearchesPerTick from storage', () => {
+    const database = freshDb();
+    database.prepare("INSERT INTO settings (key, value, updated_at) VALUES ('maxSearchesPerTick','0',1)").run();
+    expect(getSchedulerSettings(database).maxSearchesPerTick).toBeGreaterThan(0);
+  });
+  it('does not accept a string for maxSearchesPerTick from storage', () => {
+    const database = freshDb();
+    database.prepare(`INSERT INTO settings (key, value, updated_at) VALUES ('maxSearchesPerTick','"abc"',1)`).run();
+    expect(typeof getSchedulerSettings(database).maxSearchesPerTick).toBe('number');
+  });
+});
