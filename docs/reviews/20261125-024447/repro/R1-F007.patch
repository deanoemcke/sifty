+it('throws on a print-disabled format it does not recognise instead of reporting enabled', () => {
+  const run = () => parseServiceState({
+    label: 'ai.openclaw.sifty-scheduler',
+    listExitCode: 113,
+    listOutput: '',
+    printDisabledOutput: '\t\t"ai.openclaw.sifty-scheduler" => true',
+  });
+  let result: unknown;
+  try { result = run(); } catch { return; }
+  console.log(JSON.stringify(result));
+  throw new Error(`did not throw; returned ${JSON.stringify(result)}`);
+});
