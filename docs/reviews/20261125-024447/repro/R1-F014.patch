+// @vitest-environment jsdom
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { NOW_MS, makeFakeChrome } from './reproHarness';
+import { startServerTab } from './startServerTab';
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  document.body.innerHTML = '<div id="app"></div>';
+});
+afterEach(() => vi.useRealTimers());
+
+it('a failed sync message does not outlive a later healthy background refresh', async () => {
+  const root = document.getElementById('app') as HTMLElement;
+  let isHostFailing = true;
+  const { chromeApi } = makeFakeChrome({
+    syncCookies: () => {
+      if (isHostFailing) throw new Error('host unreachable');
+      return { ok: true, cookies: {} };
+    },
+  });
+  await startServerTab(root, { chromeApi, nowMs: () => NOW_MS, pollIntervalMs: 30_000 });
+  (root.querySelector('[data-section="cookies"] button') as HTMLButtonElement).click();
+  await vi.advanceTimersByTimeAsync(0);
+  expect(root.querySelector('.sync-message')!.textContent).toContain('failed');
+  isHostFailing = false;
+  await vi.advanceTimersByTimeAsync(5 * 30_000); // five healthy polls
+  expect(root.querySelector('.sync-message')?.textContent ?? '').not.toContain('failed');
+});
