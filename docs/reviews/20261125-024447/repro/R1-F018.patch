+import { vi } from 'vitest';
+import type { ChromeApi } from '../startCookieSync';
+
+export const NOW_MS = Date.parse('2026-11-25T00:00:00Z');
+type HostRequest = { type: string; [field: string]: unknown };
+
+export const DEFAULT_REPLIES: Record<string, unknown> = {
+  getStatus: {
+    ok: true,
+    cookies: { isSynced: true, isLoginUsable: true, syncedAtMs: NOW_MS - 120_000, cookieCount: 10, loginExpiryMs: NOW_MS + 81 * 86_400_000 },
+    settings: { targetIntervalMinutes: 240, maxSearchesPerTick: 5 },
+  },
+  getRunHistory: { ok: true, searches: [] },
+  tailLog: { ok: true, isLogFilePresent: true, logLines: ['a line'] },
+  getServices: {
+    ok: true,
+    servicesByName: { webapp: { isInstalled: true, isLoaded: true, isRunning: true, isEnabled: true, pid: 4242 } },
+  },
+  controlService: { ok: true, serviceName: 'webapp', state: {} },
+  syncCookies: { ok: true, cookies: {} },
+};
+
+export function makeFakeChrome(replies: Record<string, unknown | ((request: HostRequest) => unknown)> = {}) {
+  const merged = { ...DEFAULT_REPLIES, ...replies };
+  const requests: HostRequest[] = [];
+  const sendNativeMessage = vi.fn(async (_hostName: string, message: unknown) => {
+    const request = message as HostRequest;
+    requests.push(request);
+    const reply = merged[request.type];
+    return typeof reply === 'function' ? reply(request) : reply;
+  });
+  const chromeApi: ChromeApi = {
+    cookies: {
+      getAll: async () => [
+        { name: 'c_user', value: '1', domain: '.facebook.com', path: '/', secure: true, httpOnly: false, sameSite: 'no_restriction', hostOnly: false, session: true, storeId: '0' },
+      ],
+      onChanged: { addListener: () => {} },
+    },
+    runtime: { sendNativeMessage, onStartup: { addListener: () => {} }, onInstalled: { addListener: () => {} } },
+    alarms: { create: () => {}, onAlarm: { addListener: () => {} } },
+  };
+  return { chromeApi, requests };
+}
