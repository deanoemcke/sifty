+import path from 'node:path';
+import { build, type Rollup } from 'vite';
+import { expect, it } from 'vitest';
+
+it('the extension bundle does not ship the host-side /tmp log paths', async () => {
+  const output = await build({
+    configFile: path.resolve(__dirname, '../../vite.extension.config.ts'),
+    logLevel: 'silent',
+    build: { write: false },
+  });
+  const outputs = (Array.isArray(output) ? output : [output]) as Rollup.RollupOutput[];
+  const codes = outputs.flatMap((o) => o.output).flatMap((item) => (item.type === 'chunk' ? [item.code] : []));
+  expect(codes.length).toBeGreaterThan(0);
+  expect(codes.filter((code) => code.includes('/tmp/sifty'))).toEqual([]);
+}, 30_000);
