+
+describe('R1-F002: batch ordering', () => {
+  it('runs a stop before a later getServices in the same batch, as separate requests would', async () => {
+    const { dependencies } = makeServiceDependencies();
+    const slowDependencies: NativeHostDependencies = {
+      ...dependencies,
+      services: {
+        ...dependencies.services,
+        runLaunchctlAsync: async (args) => {
+          if (args[0] === 'bootout') await new Promise((resolve) => setTimeout(resolve, 20));
+          return dependencies.services.runLaunchctlAsync(args);
+        },
+      },
+    };
+
+    const reply = await handleNativeHostMessageAsync(
+      {
+        type: 'batch',
+        requests: [
+          { type: 'controlService', serviceName: 'webapp', action: 'stop' },
+          { type: 'getServices' },
+        ],
+      },
+      slowDependencies
+    );
+
+    expect(reply).toMatchObject({
+      ok: true,
+      replies: [{ ok: true }, { ok: true, servicesByName: { webapp: { isLoaded: false } } }],
+    });
+  });
+});
