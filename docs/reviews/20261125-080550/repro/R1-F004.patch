+      ok: true,
+      replies: [
+        {
+          ok: true,
+          get servicesByName(): never {
+            throw new TypeError('parser bug');
+          },
+        },
+        { ok: false, error: 'x' },
+        { ok: false, error: 'x' },
+        { ok: false, error: 'x' },
+      ],
+    };
+
+    const panels = await clientReplying(buggyReply).getPanels('webapp', 10);
+
+    expect(rejectionReasonOf(panels.services)).not.toBeInstanceOf(TypeError);
+  });
+});
