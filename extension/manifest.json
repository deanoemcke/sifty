{
  "manifest_version": 3,
  "name": "Sifty Server",
  "version": "0.1.0",
  "description": "Keeps Sifty's Facebook cookies in sync and shows the scheduler's settings and logs.",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Sifty Server"
  }
}
